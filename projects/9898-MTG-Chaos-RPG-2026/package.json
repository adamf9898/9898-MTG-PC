{
  "name": "9898-mtg-chaos-rpg-2026",
  "version": "1.0.0",
  "description": "A modular web game inspired by Magic: The Gathering, with RPG and chaos mechanics.",
  "main": "library/index.js",
  "scripts": {
    "prettify": "prettier --write \"src/**/*.{js,html,css,json,md}\"",
    "start": "npx serve . -l 3000",
    "dev": "npx serve . -l 3000",
    "phaser": "npx serve . -l 3000",
    "electron": "electron electron-main.js",
    "electron:package": "npx electron-packager . 9898-MTG-Chaos-RPG-2026 --platform=win32 --arch=x64 --out=dist-electron --overwrite --icon=src/images/favicon.ico --prune=true --ignore=coverage --ignore=dist --ignore=dist-electron --ignore=godot/export",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch --passWithNoTests",
    "test:coverage": "jest --coverage --passWithNoTests",
    "test:ci": "jest --runInBand --coverage --passWithNoTests",
    "lint": "eslint electron-main.js jest.config.js",
    "build": "node scripts/build.js",
    "analyze": "node scripts/run-analyze-project.js",
    "deep-research": "node scripts/run-deep-research-iterate.js",
    "scaffold": "node scripts/scaffold.js",
    "plan": "node scripts/plan.js",
    "improve": "node scripts/improve.js",
    "expand": "node scripts/expand.js",
    "assets": "node scripts/run-asset-iteration.js",
    "assets:cards": "node scripts/run-asset-iteration.js --type=card --count=20",
    "assets:all": "node scripts/run-asset-iteration.js --count=10",
    "iterate": "node scripts/run-master-project-iteration.js",
    "integrate": "node scripts/run-implement-integrate-improvements.js",
    "implement": "node scripts/run-implement-integrate-improvements.js",
    "create": "node scripts/create.js",
    "deploy": "node scripts/run-write-build-deploy-test-update.js",
    "report": "node scripts/run-report-project-tasks-iteration.js",
    "report:maintenance": "node scripts/run-maintenance-automation.js",
    "report:ultradeep": "node scripts/generate-ultra-deep-report.js",
    "export:html": "node scripts/export-md-to-html.js",
    "export:pdf": "node scripts/export-md-to-pdf.js",
    "auto-improve": "node scripts/run-auto-improve-game.js --once",
    "auto-improve:watch": "node scripts/run-auto-improve-game.js",
    "auto-improve:dry": "node scripts/run-auto-improve-game.js --once --dry-run",
    "auto-improve:html": "node scripts/run-auto-improve-game.js --once --target html",
    "auto-improve:vue": "node scripts/run-auto-improve-game.js --once --target vue",
    "auto-improve:react": "node scripts/run-auto-improve-game.js --once --target react",
    "auto-improve:three": "node scripts/run-auto-improve-game.js --once --target three",
    "auto-improve:phaser": "node scripts/run-auto-improve-game.js --once --target phaser",
    "auto-improve:godot": "node scripts/run-auto-improve-game.js --once --target godot",
    "genai": "node scripts/run-genaiscript-automation.js",
    "genai:catalog": "node scripts/run-genaiscript-automation.js catalog",
    "genai:list": "node scripts/run-genaiscript-automation.js --list",
    "genai:runtime": "node scripts/run-genaiscript-automation.js runtime",
    "genai:wiki": "node scripts/run-genaiscript-automation.js wiki",
    "genai:chaos": "node scripts/run-genaiscript-automation.js chaos-pack",
    "genai:scene": "node scripts/run-genaiscript-automation.js phaser-scene",
    "genai:card-studio": "genaiscript run genaisrc/generate-mtg-card-style-studio.genai.mts",
    "genai:card-studio:iterate": "npm run genai:card-studio && npm run build && npm run validate-configs",
    "genai:build": "node scripts/run-genaiscript-automation.js auto-build",
    "test:runtime": "npx jest src/modules/runtime-bridge.test.js src/modules/phaser-chaos-module.test.js src/scripts/run-generator.test.js tests/perchance-generator.test.js --runInBand",
    "lint-html-css-js-json": "jest src/scripts/lint-html-css-js-json.test.js",
    "autofix-html": "node src/scripts/autofix-html.js",
    "report-htmlhint-issues": "node src/scripts/report-htmlhint-issues.js",
    "validate-configs": "jest src/scripts/validate-configs.test.js --runInBand",
    "test-scripts": "jest src/scripts/test-scripts.test.js --runInBand",
    "boardgame-tests": "jest src/scripts/boardgame.test.js --runInBand",
    "game-tests": "jest src/scripts/game.test.js --runInBand",
    "example-tests": "node src/scripts/example.js",
    "ci": "npm run lint && npm run test && npm run analyze && npm run deep-research && npm run iterate && npm run integrate && npm run report && npm run deploy",
    "mtgBot": "echo 'Run MTG Chaos RPG agent.'",
    "analyze-agent": "npm run analyze",
    "deep-research-agent": "npm run deep-research",
    "fix-agent": "node scripts/fix-agent.js",
    "improve-agent": "npm run improve",
    "integrate-agent": "npm run integrate",
    "scaffold-agent": "npm run scaffold",
    "test-agent": "npm run test",
    "report-agent": "npm run report",
    "ultra-iterate-agent": "node scripts/ultra-iterate-agent.js",
    "GameHubAgent": "node scripts/GameHubAgent.js",
    "serve:api": "node src/server.js"
  },
  "author": "adamf9898",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamf9898/9898-MTG-PC"
  },
  "bugs": {
    "url": "https://github.com/adamf9898/9898-MTG-PC/issues"
  },
  "license": "MIT",
  "dependencies": {
    "boardgame.io": "^0.50.2",
    "copilot": "^0.0.2",
    "css": "^3.0.0",
    "dotenv": "^17.4.0",
    "esprima": "^4.0.1",
    "express": "^4.22.2",
    "htmlhint": "^1.9.2",
    "js-yaml": "^4.3.0",
    "phaser": "^4.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.3",
    "electron": "^41.2.0",
    "electron-packager": "^17.1.2",
    "eslint": "^8.56.0",
    "htmlhint": "^1.9.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jsdom": "^29.0.2",
    "marked": "^18.0.0",
    "prettier": "^3.2.2",
    "serve": "^14.2.0",
    "ts-jest": "^29.1.1"
  }
}
